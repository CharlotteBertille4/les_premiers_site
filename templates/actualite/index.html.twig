{% extends 'base.html.twig' %}

{% block title %}Galerie - Les Premiers{% endblock %}
    {% block stylesheets %}
        {{ parent() }}
        <style>
            .card-img-top {
                height: 220px;
                object-fit: cover;
                border-radius: 0.5rem;
            }
        </style>
    {% endblock stylesheets %}

{% block body %}
    <div class="text-center my-5">
        <h1 class="fw-bold">Nos actualités</h1>
{#        <p class="lead">Quelques souvenirs en images de nos activités pédagogiques et extrascolaires.</p>#}
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        {% for actualite in actualites %}
            <div class="card mb-4">
                <img src="{{ asset('uploads/images/actualites/' ~ actualite.imageName) }}" alt="{{ actualite.titre }}">
                <h3>{{ actualite.titre }}</h3>
                <p>{{ actualite.contenu|striptags|length > 150 ? actualite.contenu|slice(0, 150) ~ '...' : actualite.contenu }}</p>
                <p><small>{{ actualite.createdAt|date('d/m/Y') }}</small></p>
                <a href="{{ path('actualite_show', {id: actualite.id}) }}" class="btn btn-sm btn-primary">
                    Lire la suite
                </a>
            </div>
        {% else %}
            <p>Aucune actualité pour le moment.</p>
        {% endfor %}

    </div>
{% endblock %}
