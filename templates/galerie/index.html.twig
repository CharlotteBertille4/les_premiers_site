{% extends 'base.html.twig' %}

{% block title %}Galerie - Les Premiers{% endblock %}
    {% block stylesheets %}
        {{ parent() }}
        <style>
            .card-img-top {
                height: 220px;
                object-fit: cover;
                border-radius: 0.5rem;
            }
        </style>
    {% endblock stylesheets %}

{% block body %}
    <div class="text-center my-5">
        <h1 class="fw-bold">Galerie photos</h1>
        <p class="lead">Quelques souvenirs en images de nos activités pédagogiques et extrascolaires.</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        {% for gallerie in galleries %}
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <img src="{{ asset('uploads/images/galleries/' ~ gallerie.image) }}"
                         class="card-img-top img-fluid"
                         alt="{{ gallerie.titre }}">
                    <div class="card-body text-center">
                        <p class="card-text">{{ gallerie.titre }}</p>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center">Aucune image dans la galerie pour le moment.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
