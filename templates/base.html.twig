<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Complexe Scolaire Les Premiers{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Fonts (optionnel) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <style>
            body {
                font-family: 'Poppins', sans-serif;
            }

            .navbar-brand {
                font-weight: bold;
                color: #2a3f54;
            }

            .btn-principal {
                background-color: #0052cc;
                color: #fff;
                border-radius: 30px;
                padding: 6px 20px;
            }

            footer {
                margin-top: 50px;
                padding: 30px;
                background: #f8f9fa;
                text-align: center;
            }
        </style>
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}


</head>

<body>
<!-- 🌐 Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="{{ path('home') }}">
            <img src="{{ asset('build/images/logo.jpeg') }}" alt="Logo Les Premiers" height="75">
            CS Les Premiers
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('home') }}">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('a_propos') }}">À propos</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('formations') }}">Formations</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('galerie') }}">Galerie</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('contact') }}">Contact</a></li>
            </ul>
            <a href="{{ path('contact') }}" class="btn btn-principal ms-3">Nous contacter</a>
        </div>
    </div>
</nav>

<!-- 🔽 Contenu principal -->
<main class="container mt-5">
    {% block body %}{% endblock %}
</main>

<!-- 🔚 Pied de page -->
<footer>
    <p>&copy; {{ "now"|date("Y") }} Complexe Scolaire Les Premiers. Tous droits réservés.</p>
</footer>

</body>
</html>
